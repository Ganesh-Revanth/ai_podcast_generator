# ============================================================
#  AI News Podcast Generator — .gitignore
# ============================================================

# --- SECRETS & ENVIRONMENT VARIABLES (NEVER commit these!) ---
.env
.env.*
!.env.example          # Allow a safe template with no real values

# --- PYTHON ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc
*.egg
*.egg-info/
dist/
build/
*.whl
.eggs/
*.so

# Python virtual environments
venv/
env/
.venv/
ENV/
env.bak/
venv.bak/

# --- FASTAPI / BACKEND ---
# SQLite database (generated at runtime, not source-controlled)
*.db
*.sqlite
*.sqlite3
backend/*.db
backend/**/*.db

# Generated podcast audio files (can be large, regenerated by the app)
*.mp3
*.wav
*.ogg
backend/app/static/audio/*.mp3
backend/app/static/audio/*.wav
backend/app/static/audio/*.ogg

# Pytest / coverage
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# mypy
.mypy_cache/
.dmypy.json

# --- NODE / FRONTEND ---
node_modules/
frontend/node_modules/

# Vite build output
frontend/dist/
frontend/.vite/

# Dependency lockfiles are typically committed — keeping them in.
# package-lock.json    # Uncomment to exclude if desired

# --- IDE / EDITOR ---
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
*~

# --- OS GENERATED ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# --- LOGS ---
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- DOCKER ---
# Keep docker-compose.yml and Dockerfile in source control
# Exclude any local overrides:
docker-compose.override.yml

# --- MISC ---
*.bak
*.tmp
*.swp
.cache/